        { "name": "execute_code", "displayName": "Execute Code", "kind": "execute", "action": "execute", "summaryFields": ["code"] },
        { "name": "todo", "displayName": "Todo", "kind": "other", "action": "plan", "summaryFields": ["todos"] },
        { "name": "skill_view", "displayName": "Skill View", "kind": "read", "action": "skill", "summaryFields": ["name"] },
