      "interactionKinds": ["clarify"],
      "protocolDefaults": { "setModelApi": "set_model" },
      "detection": {
        "detectorId": "builtin.detector.hermes",
        "priority": 100,
        "invocations": [
          { "command": "hermes", "args": ["acp"] },
          { "command": "hermes-acp", "args": [] }
        ],
        "configDirs": [".hermes"],
        "configEvidence": [
          { "relativePath": "config.yaml", "format": "yaml", "fields": ["provider", "model", "default_model", "model.provider", "model.default"] },
          { "relativePath": "config.yml", "format": "yaml", "fields": ["provider", "model", "default_model", "model.provider", "model.default"] }
        ]
      },
      "tools": [
        { "name": "read_file", "displayName": "Read File", "kind": "read", "action": "read", "summaryFields": ["path"] },
