{
  "schemaVersion": 1,
  "providers": [
    {
      "provider": "peri",
      "displayName": "Peri",
      "protocol": "acp",
      "capabilities": {
        "sessionUpdates": true,
        "interactionEvents": true,
        "permissionRequests": true,
        "replay": true,
        "responseMethods": ["session/request_permission"]
      },
      "interactionKinds": ["approval", "ask-question"],
      "protocolDefaults": { "setModelApi": "config_option" },
      "detection": {
        "detectorId": "builtin.detector.peri",
        "priority": 100,
        "invocations": [{ "command": "peri", "args": ["acp"] }],
        "configDirs": [".peri"],
        "configEvidence": [
          { "relativePath": "config.json", "format": "json", "fields": ["provider", "model", "models"] },
          { "relativePath": "config.yaml", "format": "yaml", "fields": ["provider", "model", "models"] },
          { "relativePath": "settings.json", "format": "json", "fields": ["provider", "model", "models"] }
        ]
      },
      "tools": [
        { "name": "Read", "displayName": "Read", "kind": "read", "action": "read", "summaryFields": ["path", "file_path"] },
        { "name": "Write", "displayName": "Write", "kind": "edit", "action": "write", "summaryFields": ["path", "file_path"] },
        { "name": "Edit", "displayName": "Edit", "kind": "edit", "action": "edit", "summaryFields": ["path", "file_path"] },
        { "name": "Bash", "displayName": "Bash", "kind": "execute", "action": "execute", "summaryFields": ["command"] },
        { "name": "Grep", "displayName": "Grep", "kind": "search", "action": "search", "summaryFields": ["pattern"] },
        { "name": "Glob", "displayName": "Glob", "kind": "search", "action": "search", "summaryFields": ["pattern"] },
        { "name": "WebFetch", "displayName": "WebFetch", "kind": "fetch", "action": "fetch", "summaryFields": ["url"] },
        { "name": "WebSearch", "displayName": "WebSearch", "kind": "fetch", "action": "fetch", "summaryFields": ["query"] },
        { "name": "folder_operations", "displayName": "Folder Operations", "kind": "edit", "action": "edit", "summaryFields": ["folder_path"] },
        { "name": "SkillTool", "displayName": "Skill", "kind": "read", "action": "skill", "summaryFields": ["skill_name"] },
        { "name": "TodoWrite", "displayName": "TodoWrite", "kind": "other", "action": "plan", "summaryFields": ["todos"] },
        { "name": "Agent", "displayName": "Agent", "kind": "execute", "action": "delegate", "summaryFields": ["prompt"] },
        { "name": "DiscoverSkillsTool", "displayName": "Skills", "kind": "read", "action": "skill", "summaryFields": ["query"] },
        { "name": "SearchExtraTools", "displayName": "Search", "kind": "search", "action": "search", "summaryFields": ["query"] },
        { "name": "ExecuteExtraTool", "displayName": "Execute", "kind": "execute", "action": "execute", "summaryFields": ["tool_name"] },
        { "name": "ArtifactTool", "displayName": "Artifact", "kind": "execute", "action": "write", "summaryFields": ["name"] }
      ]
    },
    {
      "provider": "hermes",
      "displayName": "Hermes",
      "protocol": "acp",
      "capabilities": {
        "sessionUpdates": true,
        "interactionEvents": true,
        "permissionRequests": false,
        "replay": true,
        "responseMethods": []
