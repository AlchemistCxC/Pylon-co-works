        { "name": "web_extract", "displayName": "Web Extract", "kind": "fetch", "action": "fetch", "summaryFields": ["urls"] },
        { "name": "delegate_task", "displayName": "Delegate Task", "kind": "execute", "action": "delegate", "summaryFields": ["goal"] },
        { "name": "skills_list", "displayName": "Skills List", "kind": "read", "action": "skill", "summaryFields": ["category"] },
        { "name": "session_search", "displayName": "Session Search", "kind": "search", "action": "search", "summaryFields": ["query"] },
        { "name": "memory", "displayName": "Memory", "kind": "edit", "action": "edit", "summaryFields": ["action"] },
        { "name": "cronjob", "displayName": "Cron Job", "kind": "execute", "action": "execute", "summaryFields": ["action"] },
        { "name": "vision_analyze", "displayName": "Vision Analyze", "kind": "read", "action": "read", "summaryFields": ["image"] },
        { "name": "image_generate", "displayName": "Image Generate", "kind": "execute", "action": "execute", "summaryFields": ["prompt"] },
        { "name": "text_to_speech", "displayName": "Text To Speech", "kind": "execute", "action": "execute", "summaryFields": ["text"] }
      ]
    },
    {
      "provider": "claude-code",
      "displayName": "Claude Code",
      "protocol": "acp",
      "capabilities": {
        "sessionUpdates": true,
        "interactionEvents": true,
        "permissionRequests": true,
        "replay": true,
        "responseMethods": ["session/request_permission"]
      },
      "interactionKinds": ["approval", "ask-question"],
      "protocolDefaults": { "setModelApi": "config_option" },
      "detection": {
        "detectorId": "builtin.detector.claude-code",
        "priority": 100,
        "invocations": [
          { "command": "ccb", "args": ["--acp"] },
          { "command": "ccb-bun", "args": ["--acp"] },
          { "command": "claude-code-best", "args": ["--acp"] }
        ],
        "configDirs": [".claude"],
        "configEvidence": [
          { "relativePath": "settings.json", "format": "json", "fields": ["model", "apiKeyHelper", "env.ANTHROPIC_API_KEY", "permissions"] }
        ]
      },
      "tools": [
        { "name": "Read", "displayName": "Read", "kind": "read", "action": "read", "summaryFields": ["file_path", "path"] },
        { "name": "Write", "displayName": "Write", "kind": "edit", "action": "write", "summaryFields": ["file_path", "path"] },
        { "name": "Edit", "displayName": "Edit", "kind": "edit", "action": "edit", "summaryFields": ["file_path", "path"] },
        { "name": "Bash", "displayName": "Bash", "kind": "execute", "action": "execute", "summaryFields": ["command"] },
        { "name": "Grep", "displayName": "Grep", "kind": "search", "action": "search", "summaryFields": ["pattern"] },
        { "name": "Glob", "displayName": "Glob", "kind": "search", "action": "search", "summaryFields": ["pattern"] },
        { "name": "WebFetch", "displayName": "WebFetch", "kind": "fetch", "action": "fetch", "summaryFields": ["url"] },
        { "name": "WebSearch", "displayName": "WebSearch", "kind": "fetch", "action": "fetch", "summaryFields": ["query"] },
        { "name": "Agent", "aliases": ["Task"], "displayName": "Agent", "kind": "execute", "action": "delegate", "summaryFields": ["prompt", "description"], "capabilities": ["delegate", "subagent", "background"] },
        { "name": "TaskCreate", "displayName": "Create Task", "kind": "other", "action": "plan", "summaryFields": ["subject", "description"], "capabilities": ["plan", "task-graph"] },
        { "name": "TaskGet", "displayName": "Get Task", "kind": "read", "action": "read", "summaryFields": ["taskId"], "capabilities": ["plan", "task-graph"] },
        { "name": "TaskUpdate", "displayName": "Update Task", "kind": "other", "action": "plan", "summaryFields": ["taskId", "status"], "capabilities": ["plan", "task-graph"] },
        { "name": "TaskList", "displayName": "List Tasks", "kind": "read", "action": "read", "summaryFields": ["status"], "capabilities": ["plan", "task-graph"] },
        { "name": "TaskOutput", "displayName": "Task Output", "kind": "read", "action": "read", "summaryFields": ["task_id"], "capabilities": ["background"] },
        { "name": "TaskStop", "displayName": "Stop Task", "kind": "execute", "action": "execute", "summaryFields": ["task_id"], "capabilities": ["background", "cancel"] },
        { "name": "TodoWrite", "displayName": "Todo / Plan", "kind": "other", "action": "plan", "summaryFields": ["todos"], "capabilities": ["plan"] },
        { "name": "GoalTool", "aliases": ["Goal"], "displayName": "Goal", "kind": "other", "action": "plan", "summaryFields": ["action", "objective"], "capabilities": ["goal", "plan"] },
        { "name": "MCP", "aliases": ["ListMcpResourcesTool", "ReadMcpResourceTool", "McpAuthTool"], "displayName": "MCP", "kind": "execute", "action": "execute", "summaryFields": ["server", "tool", "arguments"], "capabilities": ["mcp", "dynamic-schema"] },
        { "name": "Skill", "aliases": ["SkillTool"], "displayName": "Skill", "kind": "read", "action": "skill", "summaryFields": ["skill", "query"], "capabilities": ["skill"] },
        { "name": "LocalMemoryRecall", "aliases": ["Memory"], "displayName": "Memory", "kind": "read", "action": "read", "summaryFields": ["action", "store", "key"], "capabilities": ["memory", "read-only"] }
      ]
