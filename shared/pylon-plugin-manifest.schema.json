{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pylon.local/schemas/pylon-plugin-manifest.schema.json",
  "title": "Pylon plugin manifest (pylon-plugin.json)",
  "description": "Plugin API 1.0/1.1 包清单。本 schema 比宿主解析器更严格（additionalProperties: false）——用于编辑器补全与 CI 校验；宿主本身忽略未知字段。真值规则见 src/plugin-runtime/packageManifest.ts。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "api", "kind", "web"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "description": "点分小写命名（如 starter.hello）"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "api": { "enum": ["1.0", "1.1"], "description": "目标 Plugin API 小版本；宿主按 allowlist 接受（1.0 插件在 1.1 宿主继续激活）" },
    "kind": {
      "enum": [
        "shell", "workspace", "feature", "hook", "renderer",
        "skin", "agent-adapter", "tool-provider", "service", "automation"
      ]
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": { "type": "string", "minLength": 1, "description": "单文件 ESM bundle 相对路径" },
        "styles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "dependencies": { "$ref": "#/definitions/versionRanges" },
    "optionalDependencies": { "$ref": "#/definitions/versionRanges" },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hotSwap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["parallel", "exclusive", "soft-remount", "restart-required"] },
        "drainTimeoutMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "reactVersion": { "type": "string" }
  },
  "definitions": {
    "versionRanges": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:\\*|\\^?\\d+\\.\\d+\\.\\d+)$",
        "description": "exact / caret / * 三种范围"
      }
    }
  }
}
