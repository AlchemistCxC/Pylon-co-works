{
  "name": "pylon",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:solid": "tsc -p tsconfig.solid.json && node scripts/check-solid-workbench-boundaries.mjs && node --experimental-strip-types scripts/check-workbench-theme-contract.mts && node --experimental-strip-types scripts/check-product-contribution-boundary.mts && node --experimental-strip-types scripts/check-renderer-architecture.mts && node --experimental-strip-types scripts/check-runtime-boundaries.mts",
    "check:boundaries": "node --experimental-strip-types scripts/check-runtime-boundaries.mts",
    "build:solid-smoke": "vite build --config vite.solid-smoke.config.ts && node scripts/check-solid-smoke-build.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:hermes-runtime": "python scripts/prepare_hermes_runtime.py",
    "build:plugin-sdk": "node scripts/build-plugin-sdk.mjs",
    "pack:portable": "python scripts/pack_release.py",
    "release:portable": "npm run build && npm run tauri -- build --no-bundle && cargo build --manifest-path src-tauri/Cargo.toml --release --bin pylon-detect && npm run pack:portable",
    "test": "vitest run",
    "test:legacy": "node --experimental-strip-types scripts/run-frontend-tests.mts",
    "test:unit": "vitest run src/domains src/infrastructure --passWithNoTests",
    "test:frontend": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:frontend": "npm run lint && npm run test:coverage && npm run build && node scripts/check-production-excludes-solid-smoke.mjs",
    "check:rust": "cd src-tauri && cargo test --lib && cargo build",
    "check:all": "npm run check:frontend && npm run check:rust && npm run check:solid",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:first-party-styles": "node --experimental-strip-types scripts/check-first-party-style-ownership.mts",
    "lint": "eslint src/",
    "build:release": "node node_modules/@tauri-apps/cli/tauri.js build"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@wooorm/starry-night": "^3.10.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "hast-util-to-html": "^9.0.5",
    "immer": "^11.1.15",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "solid-js": "^1.9.14",
    "unified": "^11.0.5",
    "vscode-oniguruma": "^2.0.1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "react-dom18": "npm:react-dom@^18.3.1",
    "react-refresh": "^0.18.0",
    "react18": "npm:react@^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
