{
  "name": "pylon",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:legacy": "node --experimental-strip-types scripts/run-frontend-tests.mts",
    "test:unit": "vitest run src/domains src/infrastructure --passWithNoTests",
    "test:integration": "vitest run",
    "test:frontend": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:frontend": "npm run lint && npm run test:frontend && npm run build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@wooorm/starry-night": "^3.10.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hast-util-to-html": "^9.0.5",
    "immer": "^11.1.15",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0",
    "vite": "^6",
    "vitest": "^4.1.10"
  }
}