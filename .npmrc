# react-dom18 (dev alias npm:react-dom@^18.3.1) 与 root react@^19 的 peer 冲突是刻意的
# 双版本共存（React 18 兼容层）。npm 需宽松 peer 解析才能安装；CI/verify 同样适用。
legacy-peer-deps=true
# 不自动实例化 peer（vite/vitest 的 optional peer @types/node 会被 pnpm 自动装入，
# 注入 node 全局类型导致 pluginScope TS2322；本项目 browser tsconfig 有意排除 node 类型）
auto-install-peers=false