node_modules/
dist/
src-tauri/target/
src-tauri/tests-harness/target/
src-tauri/pet-core/target/
src-tauri/pylon-core/target/
src-tauri/pylon-foundations/target/
# 仓库根 target/：并行施工时各 agent 放验证输出的草稿区（vitest JSON 报告、
# clippy 报告等）。本仓没有根 workspace，它不是 cargo 目标目录。此前只有
# src-tauri/*/target 被忽略，草稿目录就一直以未跟踪身份出现在 git status 里；
# 2026-09-17 起一并忽略。
/target/
*.log
# P91 B3：本地 QA 草稿不入库（_rustfail/tsc/pylon-acceptance/cargo-test* 等 log 残留已被上方 *.log 覆盖）
design-qa.md
.DS_Store
*.tsbuildinfo
__pycache__/
*.py[cod]

# 协作规范随仓库分发（2026-09-14 起入库）
# spec 为一次性工作文档，用完即弃，不入库
.agents/spec/
/references/
/.hermes/

# 测试产物
/coverage/

# ISSUE-20：Solid smoke 构建目录（生成物不入库）
dist-solid-smoke/

# ISSUE-20：发布 zip 不入库（二进制移至 release，不继续提交）
# 注意：git 2.50.1 wildmatch 对 pylon-*.win64.zip 匹配失效（实测 check-ignore rc=1），用 pylon-*win64.zip
pylon-*win64.zip

# 施工文档 Phase 1：release 产物目录不入库。
# 2026-09-11 曾把受控 WebView2 bootstrapper 作为例外入库（保证干净 checkout 可跑
# pack:portable，实测 run 34592441017）；2026-09-19 起发行包不再携带 bootstrapper
# （运行时按 Windows 自带处理，兜底由 tools/install-webview2.bat 联网下载，ADR-0014），
# 例外撤销；本地手动放置的副本按未跟踪忽略。
/resources/release/tools/MicrosoftEdgeWebview2Setup.exe
/release/
# Hermes Windows runtime is fetched and verified at release-build time; the
# binary tree is distributed in the portable archive, not committed to source.
/src-tauri/resources/runtime/git/
# #371：离线文档站产物构建期暂存进 Tauri 资源树（bundle.resources 带进发行包），
# 不入库——先例同上 runtime/git；否则数百个 dist 文件会污染共享 git status。
/src-tauri/resources/docs-site/
/.cache/pylon/

# tauri 生成 schema（构建时自动再生成，不入库）
/src-tauri/gen/

# 示例插件交叉编译产物（Linux/macOS 二进制，不入库；echo.cmd/service.mjs 脚本保留）
examples/process-plugins/*/bin/*/echo

# 本地 agent 配置（真实路径/密钥，不入库；模板见 agents.example.yaml）
agents.yaml

# codex binaries (local only)
codex.exe
codex-code-mode-host.exe

dist-plugin-devkit/

# 本地个人文件（用户环境，不入库）
nodejs/
public/*
# #267：数学字体资产（Latin Modern Math / Temml 补字形）入库；public 其余仍是本地个人文件
!public/fonts/

*.html

# 本地 bun 运行时（项目本地便携工具）
bun/

dist-plugin-sdk/

# 临时产物目录（测试/静态分析输出）。唯一被跟踪的是 clippy 基线，用负向模式保留。
/artifacts/
!/artifacts/clippy-baseline.json

# pi agent 本地运行时状态（goals/tasks 快照，不入库）
/.pi/

# ZCode agent 本地运行时状态（会话计划等快照，不入库；与 /.pi/ 同类）
/.zcode/
