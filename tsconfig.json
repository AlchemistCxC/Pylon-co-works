{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@pylon/plugin-sdk": ["src/sdk/index.ts"],
      "@pylon/plugin-sdk/testing": ["src/sdk/testing.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/renderers/solid-workbench/**/*.solid.tsx",
    "src/renderers/solid-workbench/**/*.solid.test.tsx"
  ]
}
